<IfModule mod_passenger.c>
  # Disable Passenger by default for all requests (so Apache handles React)
  PassengerEnabled off
  
  # Enable Passenger ONLY for Django backend routes
  <If "%{REQUEST_URI} =~ m#^/(api|admin|media|static)#">
    PassengerEnabled on
  </If>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ensure correct MIME types for Javascript and CSS
  <IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType text/css .css
  </IfModule>

  # 1. Disable rewriting for API, Admin, Media, and Django static files
  RewriteCond %{REQUEST_URI} ^/(api|admin|media|static) [NC]
  RewriteRule ^ - [L]

  # 2. Disable rewriting for existing physical files (e.g. /assets/main.js, /favicon.ico)
  # This ensures Apache serves Vite JS/CSS assets directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Rewrite all remaining client-side React routes to index.html
  # This fixes the 404 on refresh for /employee-dashboard, /profile, etc.
  RewriteRule ^ /index.html [L]
</IfModule>
